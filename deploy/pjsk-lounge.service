[Unit]
Description=PJSK Lounge Discord bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=lounge
WorkingDirectory=/opt/pjsk-lounge
EnvironmentFile=/etc/pjsk-lounge.env
ExecStart=/opt/pjsk-lounge/.venv/bin/python main.py
Restart=on-failure
RestartSec=20
TimeoutStopSec=45
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
MemoryMax=512M
CPUQuota=100%
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
