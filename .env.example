DISCORD_TOKEN=
APPLICATION_ID=
GUILD_ID=
# Persistent bot: direct (IPv6) or session pooler (IPv4), copied from Supabase Connect.
DATABASE_URL=
# Vercel: transaction pooler URL with lounge_api login; never use a PUBLIC_ variable.
API_DATABASE_URL=
DB_POOL_MODE=session
DB_POOL_MAX=4
DB_SSL=true
# Supabase root CA if not trusted by the system; TLS identity verification remains enabled.
DB_CA_FILE=
# Optional JSON array [{"guild_id":"actual id","channel_id":"actual id"}]. No invented IDs.
# Without this file preserve GUILD_ID + channel name join, scoped by real channel ID.
QUEUES_FILE=
# Local disposable restore target required by scripts.backup_postgres (not production).
RESTORE_DATABASE_URL=
